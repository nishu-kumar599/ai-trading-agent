# Server Environment Variables
PORT=5001
JWT_SECRET=production_secret_jwt_key_super_secure_2026

# MongoDB Cloud Connection (Optional - free MongoDB Atlas cluster)
# If provided, all user accounts, active positions, trades, learning weights persist permanently in MongoDB.
# If omitted or offline, the app automatically falls back to local storage (server/data/*.json).
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_trading_db?retryWrites=true&w=majority
